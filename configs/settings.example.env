# cp configs/settings.example.env .env
#
# Everything already works with no .env at all — the default config points the
# primary and cheap routes at the deterministic zero-key `fake` route. These
# variables are how you point a route at a real provider WITHOUT touching code.

# --- The course gateway (LiteLLM-style proxy; you never hold a raw provider key)
# RETAIL_SUPPORT_PRIMARY_BASE_URL=https://gateway.classroom.local/v1
# RETAIL_SUPPORT_PRIMARY_API_KEY=sk-participant-07

# RETAIL_SUPPORT_CHEAP_BASE_URL=https://gateway.classroom.local/v1
# RETAIL_SUPPORT_CHEAP_API_KEY=sk-participant-07

# --- Anthropic Messages dialect (comparison route)
# RETAIL_SUPPORT_COMPARISON_BASE_URL=https://api.anthropic.com
# RETAIL_SUPPORT_COMPARISON_API_KEY=sk-ant-...

# --- The open-weight route: vLLM on the classroom GPU server
# RETAIL_SUPPORT_VLLM_BASE_URL=http://gpu-server.classroom.local:8000/v1
# RETAIL_SUPPORT_VLLM_API_KEY=class-vllm-key

# --- Lab 6 switches (also settable per-command: `make replay CACHE=1`)
# RETAIL_SUPPORT_CACHE_ENABLED=1
# RETAIL_SUPPORT_SEMANTIC_CACHE_ENABLED=1
# RETAIL_SUPPORT_ROUTING_ENABLED=1
